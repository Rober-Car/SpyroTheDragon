<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        <solid> define el color de relleno del bocadillo.
        En este caso es blanco (#FFFFFF).
      -->
    <solid android:color="@color/purple_dark"/>

    <!--
        <corners> redondea las esquinas del bocadillo.
        El valor 16dp crea un aspecto suave y moderno.
    -->
    <corners android:radius="16dp"/>

    <!--
        <stroke> define el borde del bocadillo.
        - width: grosor del borde
        - color: color del borde (aquí dorado #FFD700)
        Esto permite que el bocadillo destaque visualmente.
    -->
    <stroke
        android:width="2dp"
        android:color="@color/orange_gold"/>

</shape>
