<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Fondo para los bocadillos de texto (guías). 
    Define un rectángulo con bordes redondeados, relleno púrpura suave y un borde más oscuro.
-->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Color de relleno del bocadillo (púrpura con transparencia) -->
    <solid android:color="@color/purple_light_transparent"/>

    <!-- 
        Borde del bocadillo:
        - width: 5dp de grosor.
        - color: púrpura oscuro para contraste.
    -->
    <stroke
        android:width="5dp"
        android:color="@color/purple_dark"/>

    <!-- 
        Esquinas redondeadas:
        Un radio alto (150dp) para dar un aspecto de burbuja o píldora.
    -->
    <corners android:radius="150dp"/>

</shape>