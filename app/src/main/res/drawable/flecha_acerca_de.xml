<!-- 
    Icono de flecha para la sección "Acerca de". 
    Se define un viewport de 960x960 y se aplica un tinte púrpura transparente.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="@color/purple_light_transparent">

    <!-- 
        El grupo aplica una rotación de 210 grados sobre el centro (480, 480) 
        para orientar la flecha en la dirección deseada.
    -->
    <group
        android:rotation="210"
        android:pivotX="480"
        android:pivotY="480">

        <!-- 
            Dibujo de la flecha: originalmente apunta hacia abajo antes de la rotación del grupo.
        -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M440,647L440,200Q440,183 451.5,171.5Q463,160 480,160Q497,160 508.5,171.5Q520,183 520,200L520,647L716,451Q728,439 744,439.5Q760,440 772,452Q783,464 783.5,480Q784,496 772,508L508,772Q502,778 495,780.5Q488,783 480,783Q472,783 465,780.5Q458,778 452,772L188,508Q177,497 177,480.5Q177,464 188,452Q200,440 216.5,440Q233,440 245,452L440,647Z"/>
    </group>

</vector>