<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Layout para la pantalla de bienvenida/guía del usuario.
    Utiliza ConstraintLayout para posicionar los elementos de forma flexible.
    El fondo es una imagen específica para esta pantalla inicial.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pantalla_1_welcome">

    <!-- Título principal de la pantalla -->
    <TextView
        android:id="@+id/txt_1"
        style="@style/TituloDragones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:text="@string/pt_1_titulo1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Subtítulo o texto secundario debajo del título -->
    <TextView
        android:id="@+id/txt_2"
        style="@style/texto_pequeño_blanco"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"
        android:gravity="center"
        android:text="@string/pt1_titulo_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_1" />

    <!-- Imagen del personaje (Spyro) -->
    <ImageView
        android:id="@+id/img_dragon"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/spyro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_2" />

    <!-- Logo oficial de Spyro posicionado solapando ligeramente la imagen anterior -->
    <ImageView
        android:id="@+id/logo_spyro"
        android:layout_width="120dp"
        android:layout_height="80dp"
        android:layout_marginTop="-20dp"
        android:src="@drawable/logo_spyro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_dragon" />

    <!-- Texto descriptivo o de bienvenida -->
    <TextView
        android:id="@+id/txt_3"
        style="@style/texto_pequeño_blanco"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/pt1_descripcion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_spyro" />

    <!-- 
        Elemento interactivo (Huevo con animación).
        Se marca como clickable y focusable para permitir la interacción del usuario.
    -->
    <ImageView
        android:id="@+id/boton_huevo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/animation_huevo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_3" />

    <!-- Botón para iniciar la experiencia o navegación -->
    <TextView
        style="@style/boton_inciar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:text="@string/btn_iniciar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_3" />

</androidx.constraintlayout.widget.ConstraintLayout>