<!--
    Contenedor principal del overlay del tutorial.
    - Fondo semitransparente para oscurecer la pantalla.
    - clickable + focusable → bloquea toques en la UI inferior.
    - visibility="gone" → oculto al inicio.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000"
    android:clickable="true"
    android:focusable="true"
    android:id="@+id/guideLayout"
    android:elevation="20dp"
    android:visibility="gone">

    <!--
        Imagen del “pulso” o indicador visual.
        Se coloca abajo a la izquierda para señalar un elemento.
    -->
    <ImageView
        android:id="@+id/pulseImage"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="-25dp"
        android:src="@drawable/boton_personajes_sign"
        android:layout_gravity="bottom|start" />

    <!--
        Bocadillo de texto del tutorial.
        - Empieza invisible (alpha 0).
        - scaleX/Y reducidos para animaciones de entrada.
        - Fondo personalizado con bocadillo.
    -->
    <TextView
        android:id="@+id/textBocadillo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="25dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bocadillo_guia"
        android:gravity="center"
        android:maxLines="5"
        android:padding="20dp"
        android:text="@string/guide_personajes"
        android:alpha="0"
        android:scaleX="0.7"
        android:scaleY="0.7"
        style="@style/texto_pequeño_blanco" />

    <!--
        Botón para cerrar el tutorial.
        - Fondo transparente para que solo se vea el texto.
        - Colocado arriba centrado.
    -->
    <android.widget.Button
        android:id="@+id/exit_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/finalizar_gide"
        android:layout_gravity="top|center"
        android:layout_marginTop="80dp"
        android:padding="20dp"
        android:background="@android:color/transparent"
        android:textAllCaps="false"
        style="@style/texto_medio_blanco" />

</FrameLayout>
