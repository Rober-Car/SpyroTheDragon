<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TituloDragones" parent="TextAppearance.AppCompat">
        <!-- Tamaño del texto -->
        <item name="android:textSize">40sp</item>

        <!-- Color del texto -->
        <item name="android:textColor">@color/white</item>

        <!-- Negrita, cursiva, etc. -->
        <item name="android:textStyle">bold</item>

        <!-- Espaciado entre letras -->
        <item name="android:letterSpacing">0.05</item>


        <!-- Sombra del texto -->
        <item name="android:shadowColor">@color/gray_shadow</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>


    <!-- Boton huevo iniciar-->
    <style name="boton_inciar" parent="TextAppearance.AppCompat">

        <!-- Tamaño del texto -->
        <item name="android:textSize">15sp</item>
        !-- Color del texto -->
        <item name="android:textColor">@color/purple_dark</item>
        <!-- Negrita, cursiva, etc. -->
        <item name="android:textStyle">bold</item>

    </style>


</resources>